# Copy to .env.docker and edit. Compose does NOT interpolate passwords here — safe to use '$' in secrets.
#
# Core Django
SECRET_KEY=change-me-to-a-strong-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# django.contrib.sites + allauth (set to your public host if not localhost)
SITE_DOMAIN=localhost:8000
SITE_BRAND_NAME=Ram Naam Jaap
DJANGO_ENV=production
DEBUG=False

# Email (omit EMAIL_HOST to use dummy backend until SMTP is ready — signup still works)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@your-domain.com

# Postgres
POSTGRES_DB=ram_naam_jaap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Django DB URL (must match POSTGRES_* above; host name is the compose service "db")
DATABASE_URL=postgresql://postgres:postgres@db:5432/ram_naam_jaap

# Redis / Celery (optional here; compose also sets REDIS_URL / CELERY_BROKER_URL for app services)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Optional performance tuning
DB_CONN_MAX_AGE=120
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Home page live map (Leaflet). Omit or use false to hide; set true to show again.
# SHOW_HOME_JAAP_MAP=true
